<idea-plugin>
    <id>com.patrickhanna.warrant</id>
    <name>Laravel Warrant</name>
    <version>0.2.0</version>
    <vendor email="patrick@platoalpha.com">Patrick Hanna</vendor>

    <description><![CDATA[
        Syntax highlighting for the <b>Warrant</b> authorization rule language.
        Highlights standalone <code>.warrant</code> files and, more importantly,
        the DSL embedded in PHP: heredocs/nowdocs labelled <code>WARRANT</code>, and
        strings wherever rule text is expected, such as <code>warrant('...')</code>
        and <code>Warrant::parse('...')</code>.
    ]]></description>

    <change-notes><![CDATA[
        <ul>
            <li><b>0.5.0</b> &mdash; Highlight Warrant inside PHP wherever rule text is
                expected: the first argument of <code>warrant()</code>,
                <code>Warrant::parse()</code>, <code>WarrantSyntax::parse()</code>,
                <code>WarrantParser::parse()</code> and <code>-&gt;ifRaw()</code> /
                <code>-&gt;orIfRaw()</code>, and a string returned from <code>rules()</code>
                or a <code>#[DerivedCondition]</code> / <code>#[RuleTemplate]</code> method.</li>
            <li><b>0.2.0</b> &mdash; Highlight <code>@sql "&lt;sql&gt;"</code> raw SQL
                references alongside <code>@context</code> and <code>@column</code>.</li>
            <li><b>0.1.0</b> &mdash; Initial release: Warrant DSL syntax highlighting,
                including injection into PHP heredocs labelled <code>WARRANT</code>.</li>
        </ul>
    ]]></change-notes>

    <!-- Core platform. -->
    <depends>com.intellij.modules.platform</depends>
    <!-- The injector reads PHP heredoc PSI, so we need the PHP plugin. This also
         means the plugin only loads in PhpStorm / IDEs with PHP support. -->
    <depends>com.jetbrains.php</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 1. The language + its .warrant file association. -->
        <fileType
            name="Warrant"
            language="Warrant"
            implementationClass="com.warrant.phpstorm.WarrantFileType"
            fieldName="INSTANCE"
            extensions="warrant"/>

        <!-- 2. Lexer + trivial parser (the parser is deliberately flat; the
                future language server will provide errors/completion). -->
        <lang.parserDefinition
            language="Warrant"
            implementationClass="com.warrant.phpstorm.WarrantParserDefinition"/>

        <!-- 3. Token -> color mapping. This is what produces the highlighting. -->
        <lang.syntaxHighlighterFactory
            language="Warrant"
            implementationClass="com.warrant.phpstorm.WarrantSyntaxHighlighterFactory"/>

        <!-- 4. Inject Warrant into PHP strings that hold rule text. -->
        <multiHostInjector
            implementationClass="com.warrant.phpstorm.WarrantInjector"/>
    </extensions>
</idea-plugin>
