<!-- The language-server client. Loaded only in IDEs that ship the IntelliJ
     Platform LSP API, which PhpStorm 2024.2 and later provide as part of the
     com.intellij.modules.ultimate module (see plugin.xml). -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <platform.lsp.serverSupportProvider
            implementation="com.warrant.phpstorm.lsp.WarrantLspServerSupportProvider"/>

        <!-- Starts the server for the files a project reopens with, whose tabs
             load lazily and so never report opening to the provider. -->
        <postStartupActivity
            implementation="com.warrant.phpstorm.lsp.StartWarrantLanguageServerActivity"/>

        <!-- Makes each name in Warrant text a reference to what declares it, by
             asking the server, so Cmd/Ctrl-hover underlines it, Cmd/Ctrl-click
             goes there, and a rename started on it renames that. -->
        <psi.referenceContributor
            language="Warrant"
            implementation="com.warrant.phpstorm.lsp.WarrantNameReferenceContributor"/>

        <!-- Finds the uses in rule text of a condition, template or ability, by
             asking the server, for Find Usages, Show Usages and Rename on the
             PHP that declares it. -->
        <referencesSearch
            implementation="com.warrant.phpstorm.lsp.WarrantReferencesSearcher"/>

        <!-- A key given to a condition's or template's attribute, and an ability
             constant's value, are PHP strings: renaming one, finding its usages
             and Cmd/Ctrl-clicking it each need taking up here. -->
        <renamePsiElementProcessor
            implementation="com.warrant.phpstorm.lsp.WarrantNameStringRenameProcessor"
            order="first"/>
        <renameHandler
            implementation="com.warrant.phpstorm.lsp.WarrantNameStringRenameHandler"/>
        <elementDescriptionProvider
            implementation="com.warrant.phpstorm.lsp.WarrantNameStringDescriptionProvider"/>
        <findUsagesHandlerFactory
            implementation="com.warrant.phpstorm.lsp.WarrantNameStringFindUsagesHandlerFactory"/>
        <usageTargetProvider
            implementation="com.warrant.phpstorm.lsp.WarrantNameStringUsageTargetProvider"/>
        <gotoDeclarationHandler
            implementation="com.warrant.phpstorm.lsp.WarrantNameStringGotoUsagesHandler"/>

        <!-- Shows a condition or template method, or an ability constant, as
             used while rule text names it, since Warrant calls it by
             reflection and no PHP does. -->
        <phpDeadCode
            implementation="com.warrant.phpstorm.lsp.WarrantEntryPoint"/>

        <!-- Checks a new name for a condition, template or ability against rule
             text and the schemas that have it. -->
        <renameInputValidator
            implementation="com.warrant.phpstorm.lsp.WarrantRenameInputValidator"/>

        <projectService
            serviceImplementation="com.warrant.phpstorm.lsp.WarrantSettings"/>

        <projectService
            serviceImplementation="com.warrant.phpstorm.lsp.WarrantServerQueries"/>

        <projectConfigurable
            parentId="language"
            id="com.warrant.phpstorm.settings"
            displayName="Warrant"
            nonDefaultProject="true"
            instance="com.warrant.phpstorm.lsp.WarrantSettingsConfigurable"/>

        <notificationGroup
            id="Warrant"
            displayType="BALLOON"/>

        <!-- Formats the Warrant in a PHP file as part of Reformat Code, and so of
             Actions on Save, after the PHP is formatted. -->
        <postFormatProcessor
            implementation="com.warrant.phpstorm.lsp.WarrantPostFormatProcessor"/>

        <!-- Formats a .warrant file while Reformat Code runs, ahead of the
             platform's LSP formatting, which would apply after a save. -->
        <formattingService
            implementation="com.warrant.phpstorm.lsp.WarrantFormattingService"
            order="first"/>
    </extensions>

    <projectListeners>
        <!-- Offers the builder and Laravel strings that may name a renamed
             condition or ability. -->
        <listener
            class="com.warrant.phpstorm.lsp.WarrantNameStringsAfterRename"
            topic="com.intellij.refactoring.listeners.RefactoringEventListener"/>
    </projectListeners>

    <actions>
        <action
            id="Warrant.RestartLanguageServer"
            class="com.warrant.phpstorm.lsp.RestartWarrantLanguageServerAction"
            text="Restart Warrant Language Server"
            description="Stop the Warrant language server and start it again">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action
            id="Warrant.ReformatRules"
            class="com.warrant.phpstorm.lsp.ReformatWarrantRulesAction"
            text="Reformat Warrant Rules"
            description="Format the Warrant rule text in this file through the Warrant language server">
            <add-to-group group-id="CodeFormatGroup" anchor="after" relative-to-action="ReformatCode"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
