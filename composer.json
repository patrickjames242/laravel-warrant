{
    "name": "patrickhanna/laravel-warrant",
    "description": "Schema-based authorization and permissions for Laravel, with database-scoped ability checks.",
    "keywords": ["laravel", "authorization", "permissions", "schemas", "access-control"],
    "license": "MIT",
    "authors": [
        {
            "name": "Patrick Hanna",
            "email": "patrick@platoalpha.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "laravel/octane": "^2.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Warrant\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Warrant\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Warrant\\WarrantServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
