#!/usr/bin/env php
<?php

/*
 * Formats Warrant rule text: `.warrant` files, and the rule text in PHP files,
 * in the one style specs/formatter.md sets out.
 *
 *     warrant-format [<path>...] [--check] [--diff] [--ignore-unparsable]
 *     warrant-format --stdin-filepath=<path> [--ignore-unparsable]
 *
 * Each path is a file, a directory or a glob pattern, read as
 * Warrant\DSL\Formatting\RuleTextFiles reads them, from the current directory;
 * with none, the current directory. Files are rewritten in place.
 *
 *  --check              Write nothing; list the files that would change.
 *  --diff               Write nothing; show what would change in each.
 *  --ignore-unparsable  Report rule text that does not parse, but do not fail.
 *  --stdin-filepath     Format standard input as the file at <path> would be,
 *                       and write it to standard output: the form an editor
 *                       runs as an external formatter.
 *
 * The exit code is 0 when everything is formatted, 1 when --check or --diff
 * found a file to change, and 2 when rule text did not parse or a path matched
 * nothing.
 *
 * Like the language server, it loads this package's classes from its own
 * `src/` directory and boots no application, so it runs in CI before anything
 * is configured.
 */

spl_autoload_register(static function (string $class): void {
    if (str_starts_with($class, 'Warrant\\')) {
        $file = __DIR__.'/../src/'.str_replace('\\', '/', substr($class, strlen('Warrant\\'))).'.php';

        if (is_file($file)) {
            require $file;
        }
    }
});

ini_set('display_errors', 'stderr');
error_reporting(E_ALL & ~E_DEPRECATED);

$arguments = array_slice($argv, 1);
$options = array_values(array_filter($arguments, static fn (string $argument): bool => str_starts_with($argument, '--')));
$paths = array_values(array_filter($arguments, static fn (string $argument): bool => ! str_starts_with($argument, '--')));

if (array_intersect($arguments, ['-h', '--help']) !== []) {
    fwrite(STDOUT, "Usage: warrant-format [<path>...] [--check] [--diff] [--ignore-unparsable]\n       warrant-format --stdin-filepath=<path> [--ignore-unparsable]\n");
    exit(0);
}

$check = in_array('--check', $options, true);
$diff = in_array('--diff', $options, true);
$ignoreUnparsable = in_array('--ignore-unparsable', $options, true);
$formatter = new Warrant\DSL\Formatting\FileFormatter;

foreach ($options as $option) {
    if (str_starts_with($option, '--stdin-filepath=')) {
        $path = substr($option, strlen('--stdin-filepath='));
        fwrite(STDOUT, $formatter->formatted($path, (string) stream_get_contents(STDIN)));

        foreach ($formatter->problems() as $problem) {
            fwrite(STDERR, "{$path}:{$problem['line']}: {$problem['message']}\n");
        }

        exit($formatter->problems() !== [] && ! $ignoreUnparsable ? 2 : 0);
    }
}

$base = (string) getcwd();
$found = Warrant\DSL\Formatting\RuleTextFiles::matching($paths, $base);
$failed = false;

foreach ($found->unmatched as $argument) {
    fwrite(STDERR, "No file, directory or pattern matches \"{$argument}\".\n");
    $failed = true;
}

foreach ($found->unsupported as $argument) {
    fwrite(STDERR, "{$argument} is not a .warrant or .php file.\n");
    $failed = true;
}

$changed = $unchanged = $skipped = 0;

foreach ($found->files as $file) {
    $shown = Warrant\DSL\Formatting\RuleTextFiles::relativeTo($file, $base);
    $text = (string) file_get_contents($file);
    $formatted = $formatter->formatted($file, $text);

    foreach ($formatter->problems() as $problem) {
        fwrite(STDERR, "{$shown}:{$problem['line']}: {$problem['message']}\n");
    }

    if ($formatter->problems() !== []) {
        $skipped++;
        $failed = $failed || ! $ignoreUnparsable;
    }

    if ($formatted === $text) {
        $unchanged += $formatter->problems() === [] ? 1 : 0;

        continue;
    }

    $changed++;

    if ($diff) {
        fwrite(STDOUT, Warrant\DSL\Formatting\UnifiedDiff::of($text, $formatted, $shown));
    } elseif ($check) {
        fwrite(STDOUT, "{$shown}\n");
    } else {
        file_put_contents($file, $formatted);
        fwrite(STDOUT, "Formatted {$shown}\n");
    }
}

$files = static fn (int $count): string => $count === 1 ? '1 file' : "{$count} files";
fwrite(STDOUT, sprintf(
    "%s %s, %d skipped, %d already formatted.\n",
    $files($changed),
    $check || $diff ? 'would be formatted' : 'formatted',
    $skipped,
    $unchanged,
));

exit($failed ? 2 : (($check || $diff) && $changed > 0 ? 1 : 0));
